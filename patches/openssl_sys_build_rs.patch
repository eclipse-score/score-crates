diff -urN a/build/main.rs b/build/main.rs
--- a/build/main.rs
+++ b/build/main.rs
@@ -131,1 +131,58 @@
-fn main() {
+fn main() {
+    // 1. Read the generated build info text file hermetically from the sandbox
+    let info = std::fs::read_to_string("external/score_openssl/openssl_build_info.txt")
+        .unwrap_or_else(|_| "3.6.1\nOPENSSL_NO_ACVP_TESTS,OPENSSL_NO_OCSP,OPENSSL_NO_SM4".to_string());
+    let mut lines = info.lines();
+
+    let requested_version = lines.next().unwrap();
+    let conf_flags = lines.next().unwrap_or_default();
+
+    // 2. Parse Major, Minor, and Patch versions from C++ Source of Truth
+    let req_major: u32 = requested_version.split('.').next().unwrap_or("3").parse().unwrap_or(3);
+    let req_minor: u32 = requested_version.split('.').nth(1).unwrap_or("0").parse().unwrap_or(0);
+    let req_patch: u32 = requested_version.split('.').nth(2).unwrap_or("0").parse().unwrap_or(0);
+
+    // 3. Define the physical compatibility ceiling of this specific openssl-sys crate
+    let max_major: u32 = 3;
+    let max_minor: u32 = 5; 
+    let max_patch: u32 = 0;
+
+    // 4. THE FAIL-FAST SAFETY CHECK (Prevents Runtime Segfaults)
+    if req_major > max_major {
+        panic!("FATAL ABI MISMATCH: Requested OpenSSL major version is too high!");
+    }
+
+    // 5. CAP THE VERSION: If C++ is newer than Rust FFI, fallback to Rust's max supported minor/patch
+    let final_minor = std::cmp::min(req_minor, max_minor);
+    let final_patch = if req_minor > max_minor { 0 } else { req_patch };
+
+    // 6. Dynamically calculate the hex version (MNNFF00f format)
+    let version_hex = (req_major << 28) | (final_minor << 20) | (final_patch << 12) | 0xf;
+    
+    // 7. Output safe compile configurations natively to rustc
+    println!("cargo:rustc-cfg=openssl");
+    println!("cargo:rustc-cfg=ossl101");
+    println!("cargo:rustc-cfg=ossl102");
+    println!("cargo:rustc-cfg=ossl102f");
+    println!("cargo:rustc-cfg=ossl102h");
+    println!("cargo:rustc-cfg=ossl110");
+    println!("cargo:rustc-cfg=ossl110f");
+    println!("cargo:rustc-cfg=ossl110g");
+    println!("cargo:rustc-cfg=ossl110h");
+    println!("cargo:rustc-cfg=ossl111");
+    println!("cargo:rustc-cfg=ossl111b");
+    println!("cargo:rustc-cfg=ossl111c");
+    println!("cargo:rustc-cfg=ossl111d");
+    println!("cargo:rustc-cfg=ossl300");
+
+    // 8. Dynamically emit minor version flags up to the safe fallback limit
+    for m in 1..=final_minor {
+        println!("cargo:rustc-cfg=ossl3{}0", m);
+    }
+
+    // 9. Output the dynamic compatibility ceiling version hex
+    println!("cargo:version_number={:x}", version_hex);
+
+    // 10. Gate out disabled features at compile-time to prevent LLVM coverage linking crashes (Issue #200)
+    println!("cargo:conf={}", conf_flags);
+    std::process::exit(0);
 }
